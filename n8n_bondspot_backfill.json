{
  "name": "BondSpot Fixing - Backfill / Gap Filler",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "Europe/Warsaw"
  },
  "nodes": [
    {
      "id": "trigger",
      "name": "Schedule Daily 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 3 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "supabase_url",
              "type": "string",
              "value": "https://YOUR-PROJECT-REF.supabase.co"
            },
            {
              "id": "a1",
              "name": "from_date",
              "type": "string",
              "value": "2011-01-01"
            },
            {
              "id": "a2",
              "name": "max_pairs_per_run",
              "type": "number",
              "value": 200
            },
            {
              "id": "a3",
              "name": "throttle_ms",
              "type": "number",
              "value": 1000
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "fetchMissing",
      "name": "RPC: bondspot_missing_fixings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/rpc/bondspot_missing_fixings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_from: $json.from_date, p_limit: $json.max_pairs_per_run }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "splitMissing",
      "name": "Split Missing Pairs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// PostgREST returns the RPC result as a JSON array at the top level.\n// n8n HTTP Request usually wraps it under $json (object) or returns each item.\n// Be defensive: handle both shapes.\nconst inItem = $input.first().json;\nlet arr = [];\nif (Array.isArray(inItem)) {\n  arr = inItem;\n} else if (Array.isArray(inItem.data)) {\n  arr = inItem.data;\n} else if (Array.isArray(inItem.body)) {\n  arr = inItem.body;\n} else {\n  // fallback: gather all input items\n  arr = $input.all().map((i) => i.json);\n}\n\nreturn arr.map((p) => {\n  const dateIso = p.fixing_date; // 'YYYY-MM-DD'\n  const [y, m, d] = dateIso.split('-');\n  const dateParam = `${y}${m}${d}`;\n  const monthParam = String(parseInt(m, 10));\n  const yearParam = y;\n  return {\n    json: {\n      fixing_date: dateIso,\n      fixing_session: p.fixing_session,\n      date_param: dateParam,\n      month_param: monthParam,\n      year_param: yearParam,\n      source_url: `https://www.bondspot.pl/fixing_obligacji?date=${dateParam}&month=${monthParam}&year=${yearParam}&type=${p.fixing_session}`\n    }\n  };\n});"
      }
    },
    {
      "id": "loop",
      "name": "Loop (1 at a time)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1140, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "throttle",
      "name": "Throttle",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1380, 400],
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      }
    },
    {
      "id": "fetchHtml",
      "name": "Fetch BondSpot HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, 400],
      "parameters": {
        "url": "={{ $json.source_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; n8n-bondspot-scraper/1.0)"
            },
            {
              "name": "Accept",
              "value": "text/html,application/xhtml+xml"
            }
          ]
        }
      }
    },
    {
      "id": "parseHtml",
      "name": "Parse Bond Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1860, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Mirrors the parser in the daily workflow.\nconst out = [];\nfor (const item of $input.all()) {\n  // We need original meta (fixing_date, fixing_session, source_url) - get it from the previous \"Loop\" iteration via $('Loop (1 at a time)').item.json\n  const meta = $('Loop (1 at a time)').item.json;\n  const source = String(item.json.data || item.json.body || item.json.raw || '');\n\n  const parseNum = (s) => {\n    if (s === undefined || s === null) return null;\n    let t = String(s).trim();\n    if (t === '' || t === '-' || t === '\\u2013' || t === '\\u2014') return null;\n    t = t.replace(/\\s/g, '').replace(',', '.');\n    const n = parseFloat(t);\n    return Number.isFinite(n) ? n : null;\n  };\n\n  const rowRegex = /<tr>\\s*<td>(\\d+)<\\/td>\\s*<td>([^<]+)<\\/td>\\s*<td>(PL[A-Z0-9]{10})<\\/td>\\s*<td[^>]*>([^<]*)<\\/td>\\s*<td[^>]*>([^<]*)<\\/td>\\s*<td[^>]*>([^<]*)<\\/td>\\s*<td[^>]*>([^<]*)<\\/td>\\s*<td[^>]*>([^<]*)<\\/td>\\s*<td[^>]*>([^<]*)<\\/td>\\s*<\\/tr>/g;\n\n  const rows = [];\n  let m;\n  while ((m = rowRegex.exec(source)) !== null) {\n    rows.push({\n      fixing_date: meta.fixing_date,\n      fixing_session: meta.fixing_session,\n      isin: m[3].trim(),\n      lp: parseInt(m[1], 10),\n      name: m[2].trim(),\n      bid_price: parseNum(m[4]),\n      ask_price: parseNum(m[5]),\n      bid_yield: parseNum(m[6]),\n      ask_yield: parseNum(m[7]),\n      fixing_price: parseNum(m[8]),\n      fixing_yield: parseNum(m[9]),\n      source_url: meta.source_url\n    });\n  }\n\n  out.push({\n    json: {\n      fixing_date: meta.fixing_date,\n      fixing_session: meta.fixing_session,\n      source_url: meta.source_url,\n      rows,\n      rows_count: rows.length,\n      status: rows.length > 0 ? 'ok' : 'empty'\n    }\n  });\n}\nreturn out;"
      }
    },
    {
      "id": "ifHasRows",
      "name": "Has Rows?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2100, 400],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "upsertFixing",
      "name": "Upsert Fixing Rows (Supabase REST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2340, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/bondspot_fixing?on_conflict=fixing_date,fixing_session,isin",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "logOk",
      "name": "Log scrape: ok",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2580, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/bondspot_scrape_log?on_conflict=fixing_date,fixing_session",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fixing_date: $('Parse Bond Rows').item.json.fixing_date, fixing_session: $('Parse Bond Rows').item.json.fixing_session, status: 'ok', rows_count: $('Parse Bond Rows').item.json.rows_count, source_url: $('Parse Bond Rows').item.json.source_url, scraped_at: new Date().toISOString() }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "logEmpty",
      "name": "Log scrape: empty",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2340, 500],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/bondspot_scrape_log?on_conflict=fixing_date,fixing_session",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fixing_date: $json.fixing_date, fixing_session: $json.fixing_session, status: 'empty', rows_count: 0, source_url: $json.source_url, scraped_at: new Date().toISOString() }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "mergeBack",
      "name": "Merge → back to loop",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2820, 400],
      "parameters": {
        "mode": "append",
        "options": {}
      }
    }
  ],
  "connections": {
    "Schedule Daily 03:00": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "RPC: bondspot_missing_fixings", "type": "main", "index": 0 }]]
    },
    "RPC: bondspot_missing_fixings": {
      "main": [[{ "node": "Split Missing Pairs", "type": "main", "index": 0 }]]
    },
    "Split Missing Pairs": {
      "main": [[{ "node": "Loop (1 at a time)", "type": "main", "index": 0 }]]
    },
    "Loop (1 at a time)": {
      "main": [
        [],
        [{ "node": "Throttle", "type": "main", "index": 0 }]
      ]
    },
    "Throttle": {
      "main": [[{ "node": "Fetch BondSpot HTML", "type": "main", "index": 0 }]]
    },
    "Fetch BondSpot HTML": {
      "main": [[{ "node": "Parse Bond Rows", "type": "main", "index": 0 }]]
    },
    "Parse Bond Rows": {
      "main": [[{ "node": "Has Rows?", "type": "main", "index": 0 }]]
    },
    "Has Rows?": {
      "main": [
        [{ "node": "Upsert Fixing Rows (Supabase REST)", "type": "main", "index": 0 }],
        [{ "node": "Log scrape: empty", "type": "main", "index": 0 }]
      ]
    },
    "Upsert Fixing Rows (Supabase REST)": {
      "main": [[{ "node": "Log scrape: ok", "type": "main", "index": 0 }]]
    },
    "Log scrape: ok": {
      "main": [[{ "node": "Merge → back to loop", "type": "main", "index": 0 }]]
    },
    "Log scrape: empty": {
      "main": [[{ "node": "Merge → back to loop", "type": "main", "index": 1 }]]
    },
    "Merge → back to loop": {
      "main": [[{ "node": "Loop (1 at a time)", "type": "main", "index": 0 }]]
    }
  }
}
